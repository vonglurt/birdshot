# Python
__pycache__/
*.py[cod]
*.egg-info/
.venv/

# `make dist` output -- releases are built by CI, never committed
dist/
build/

# macOS
.DS_Store

# Editors
*.swp
*~

# Captured data never belongs in the repo -- sessions run to thousands of
# 12 MP frames and are managed by the storage cascade instead.
birdshot-data/
*.jpg
*.jpeg
*.mp4
*.h264
index.jsonl
session.json
group.json

# Local runtime state
settings.json

# Byte-compiled output from `make lint`
.audit-blobs

# Screenshots are committed deliberately, one at a time, after review --
# never by a bulk `git add`. The capture root is excluded above; this stops a
# stray frame arriving via assets/.
assets/**/*.jpg
assets/**/*.jpeg
!assets/screenshots/*.png
