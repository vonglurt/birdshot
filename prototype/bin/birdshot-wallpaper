"""Run the live-view wallpaper follower from a bare checkout.

The implementation lives in birdshot.wallpaper; an installed package gets this
same command as a console script (see pyproject.toml and docs/PACKAGING.md).
"""

import os
import sys

sys.path.insert(0, os.path.join(os.path.dirname(os.path.dirname(os.path.abspath(__file__))), "src"))

from birdshot.wallpaper import main  # noqa: E402

if __name__ == "__main__":
    try:
        sys.exit(main())
    except KeyboardInterrupt:
        sys.exit(0)
