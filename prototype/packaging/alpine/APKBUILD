# birdshot for Alpine, and for copal -- the Alpine flavour whose desktop ships
# birdshot as its preferred camera software. This is the flagship channel
# (docs/PACKAGING.md, Phases 4.1 and 6): the -pyc subpackage ships
# ahead-of-time-compiled bytecode so first launch on the appliance never pays
# the compile, and copal's image build runs `birdshot-cli doctor --json` after
# install and fails the image if doctor fails.
#
# Dependency names follow copal's aports tree. PyQt5's apk name varies between
# trees (py3-qt5 / py3-pyqt5); pin it to whatever copal carries. Without it the
# CLI is fully functional and only birdshot-gui is absent.

pkgname=birdshot
pkgver=1.1.0_rc1        # apk spelling of 1.1.0-rc1; bump with the tag
pkgrel=0
pkgdesc="Bird and sky capture for the Raspberry Pi HQ Camera"
url="https://birdshot.org"
arch="noarch"
license="MIT"
depends="python3 py3-numpy ffmpeg"
makedepends="py3-gpep517 py3-setuptools py3-wheel py3-installer"
subpackages="$pkgname-pyc $pkgname-doc"
source="$pkgname-$pkgver.tar.gz::https://github.com/vonglurt/birdshot/archive/refs/tags/v${pkgver/_/-}.tar.gz"
builddir="$srcdir/$pkgname-${pkgver/_/-}"
options="!check"        # the test suite is `birdshot-cli selftest`: it needs
                        # the physical camera, so it runs at image-build time
                        # via doctor + selftest, not inside abuild

build() {
	gpep517 build-wheel --wheel-dir .dist --output-fd 3 3>&1 >&2
}

package() {
	python3 -m installer -d "$pkgdir" .dist/*.whl
	install -Dm644 packaging/share/birdshot.desktop \
		"$pkgdir/usr/share/applications/birdshot.desktop"
	install -Dm644 README.md "$pkgdir/usr/share/doc/$pkgname/README.md"
	install -Dm644 docs/GUIDE.md "$pkgdir/usr/share/doc/$pkgname/GUIDE.md"
}
