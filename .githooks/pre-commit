#!/usr/bin/env bash
# SPDX-License-Identifier: MIT
# Copyright (c) 2026 Paul Richeson
#
# .githooks/pre-commit -- the sanitisation gate.
#
# This repository was published out of a working tree that had a real Pi on a
# real LAN in it: a private address, a /home/<user> path, a USB stick's volume
# label. Those were scrubbed from every commit once. The point of this hook is
# that they do not come back, because the machine that develops birdshot is
# still that same machine and every one of those strings is one careless
# `sync.sh` edit away from being staged again.
#
# It scans STAGED CONTENT ONLY -- what is about to enter history, not what is
# lying around in the working tree. Untracked scratch files are your business.
#
# Activate once:
#     git config core.hooksPath .githooks     # or: make hooks
#
# Override for a single commit, deliberately:
#     BIRDSHOT_ALLOW_UNSANITISED=1 git commit ...

set -uo pipefail

if [ "${BIRDSHOT_ALLOW_UNSANITISED:-}" = "1" ]; then
    echo "[pre-commit] sanitisation gate bypassed by request" >&2
    exit 0
fi

fail=0

note() {
    # note <file> <rule> <why>
    printf '  %-34s %s\n         %s\n' "$1" "$2" "$3" >&2
    fail=1
}

staged() { git diff --cached --name-only --diff-filter=ACM; }

# Content of a staged file as it will be committed (not as it sits on disk).
blob() { git show ":$1" 2>/dev/null; }

while IFS= read -r f; do
    [ -n "$f" ] || continue

    # -- 1. Files that are never source -------------------------------------
    case "$f" in
        *.log|*.jpg|*.jpeg|*.png|*.mp4|*.h264|*.jsonl|.DS_Store|*/.DS_Store)
            note "$f" "not source" \
                 "captures, logs and OS noise do not belong in history"
            continue
            ;;
    esac

    # The files that DEFINE these rules have to spell the patterns in order
    # to match them, so they are exempt from their own scan -- by exact path,
    # which is not a loophole anyone can fall into accidentally. Every other
    # file is scanned, the lab report documenting the scrub included.
    case "$f" in .githooks/pre-commit|Makefile) continue;; esac

    # Everything below is a text scan; skip anything that is not text.
    blob "$f" | grep -qI . 2>/dev/null || continue
    content="$(blob "$f")"

    # -- 2. Private network addresses ---------------------------------------
    if printf '%s' "$content" | grep -qE '\b(192\.168\.[0-9]{1,3}\.[0-9]{1,3}|10\.[0-9]{1,3}\.[0-9]{1,3}\.[0-9]{1,3}|172\.(1[6-9]|2[0-9]|3[01])\.[0-9]{1,3}\.[0-9]{1,3})\b'; then
        note "$f" "private IP address" \
             "use the PI_HOST env var or the raspberrypi.local default"
    fi

    # -- 3. Somebody's home directory ---------------------------------------
    if printf '%s' "$content" | grep -oE '/home/[a-z_][a-z0-9_-]*' \
         | grep -qvE '^/home/pi$'; then
        note "$f" "personal home path" \
             "the deployed account is 'pi'; use /home/pi, \$HOME or ~"
    fi

    # -- 4. A specific person's removable media ------------------------------
    if printf '%s' "$content" | grep -oE '/media/[a-z_][a-z0-9_-]*' | grep -qvE '^/media/(pi|<user>)$'; then
        note "$f" "personal media path" \
             "mount points are per-machine; use /media/pi/LABEL or a variable"
    fi

    # -- 5. The pre-rebrand name --------------------------------------------
    # 'picamera2' is the upstream dependency and is legitimate; the bare word
    # is the old project name and is not.
    #
    # Two kinds of file must be allowed to contain it: this hook, which has to
    # spell the pattern in order to match it, and the history documents that
    # record the rename -- a lab report that cannot name the thing it renamed
    # is not a record of anything. Those opt out with an explicit marker line
    # rather than by living in an exempt directory, so the exemption is
    # greppable and every use of it is visible in review.
    if ! printf '%s' "$content" | grep -q 'birdshot-lint: allow-legacy-name'; then
        if printf '%s' "$content" | grep -oE '\bpicam\b' | grep -q .; then
            note "$f" "pre-rebrand name 'picam'" \
                 "the project is birdshot; add 'birdshot-lint: allow-legacy-name' if this is a history document"
        fi
    fi

    # -- 6. Key material ----------------------------------------------------
    if printf '%s' "$content" | grep -qE 'BEGIN (RSA |OPENSSH |EC |DSA |PGP )?PRIVATE KEY'; then
        note "$f" "private key material" \
             "no key of any kind belongs in this repository"
    fi

done < <(staged)

if [ "$fail" -ne 0 ]; then
    cat >&2 <<'MSG'

[pre-commit] REFUSED -- staged content would un-sanitise the repository.

Fix the lines above, or if this is genuinely intended:

    BIRDSHOT_ALLOW_UNSANITISED=1 git commit ...

MSG
    exit 1
fi

exit 0
