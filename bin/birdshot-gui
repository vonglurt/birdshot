"""Launch the birdshot GUI from a bare checkout, no install step needed.

The implementation lives in birdshot.gui.app; an installed package gets this
same command as a console script (see pyproject.toml and docs/PACKAGING.md).
"""

import os
import sys

sys.path.insert(0, os.path.join(os.path.dirname(os.path.dirname(os.path.abspath(__file__))), "src"))

from birdshot.gui.app import main  # noqa: E402

if __name__ == "__main__":
    sys.exit(main())
